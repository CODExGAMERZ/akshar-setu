# AksharSetu AI Engine Environment Configuration
# NOTE: Variables here are SERVER-SIDE ONLY and never exposed to the client/browser bundle.

# Google Gemini API Key (Recommended for high-speed Indic translation & dyslexia simplification)
# Get a free key at https://aistudio.google.com
GEMINI_API_KEY=

# OpenAI API Key (Optional fallback or alternative)
OPENAI_API_KEY=

# Groq API Key (Optional ultra-fast Llama 3 inference)
GROQ_API_KEY=

# Sarvam AI API Key (High-Fidelity Indian TTS with Bulbul & Indic Translation with Mayura)
# Supports 11 Indian Languages (hi-IN, bn-IN, ta-IN, te-IN, mr-IN, gu-IN, kn-IN, ml-IN, pa-IN, od-IN, en-IN)
SARVAM_API_KEY=
